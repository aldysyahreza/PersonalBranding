# Salin file ini menjadi `.env` (sudah di-.gitignore) lalu isi seperlunya.
# Semua variabel bersifat opsional. Aplikasi tetap berjalan tanpa API key:
# transkrip bisa diketik/diimpor manual dan rencana edit memakai aturan lokal.

# Port & host server lokal (default hanya bisa diakses dari komputer ini)
PORT=4317
HOST=127.0.0.1

# Lokasi data (relatif ke folder repository bila bukan path absolut)
PROJECTS_DIR=projects
OUTPUT_DIR=output

# Batas ukuran video sumber yang diunggah lewat browser (MB)
MAX_UPLOAD_MB=4096

# --- Transkripsi lokal (disarankan, data tidak keluar dari komputer) ---
# Butuh: pip install faster-whisper
# Model: tiny | base | small | medium | large-v3  (lebih besar = lebih akurat, lebih lambat)
WHISPER_MODEL=small
WHISPER_PYTHON=python3
# Kosongkan untuk deteksi otomatis, atau isi kode bahasa, mis. id / en
WHISPER_LANGUAGE=

# --- Transkripsi cloud (opsional, OpenAI Whisper API) ---
# Audio (bukan video) akan dikirim ke OpenAI HANYA setelah Anda menyetujui di UI.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Rencana edit berbantuan Claude (opsional) ---
# Hanya TEKS transkrip yang dikirim, dan hanya setelah persetujuan di UI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
