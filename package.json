{
  "name": "personal-branding-video-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Aplikasi lokal untuk mengubah video talking head raw menjadi video personal branding (subtitle, kartu visual, audio, warna, ekspor) memakai ffmpeg.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "check": "node server/check-env.js",
    "test": "node --test test/*.test.js",
    "studio": "node scripts/launcher.mjs",
    "stop": "node scripts/launcher.mjs --stop",
    "autostart:on": "node scripts/launcher.mjs --install-autostart",
    "autostart:off": "node scripts/launcher.mjs --uninstall-autostart"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "hyperframes": "0.8.210",
    "gsap": "^3.15.0"
  },
  "license": "UNLICENSED"
}
