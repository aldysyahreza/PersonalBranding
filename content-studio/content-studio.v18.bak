<title>Content Studio The Brand Fixer</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;800&family=Caveat:wght@600&family=Fraunces:ital,opsz,wght@1,9..144,400&family=JetBrains+Mono:wght@500&family=Outfit:wght@400;500;600&display=swap">
<style>
/* Layout: sticky top bar with four working views; Studio is a two-column desk (editor left, live slide preview right). */
:root{
  --bg:#FBF8F3; --panel:#FFFFFF; --panel-2:#F4EBD9; --sand:#E7DDCD;
  --ink:#0F0E0C; --ink-soft:#2A2824; --muted:#6B6560; --line:rgba(15,14,12,.14);
  --accent:#B84A2E; --accent-ink:#9E3F25; --amber:#C8944A;
  --good:#2F6B43; --good-bg:rgba(47,107,67,.12); --warn:#8A5A12; --warn-bg:rgba(200,148,74,.2); --bad:#A8261C; --bad-bg:rgba(168,38,28,.1);
  --on-accent:#FFFFFF;
  /* slide tokens: the carousel always renders in brand colors, whatever the page theme */
  --s-paper:#FBF8F3; --s-cream:#F4EBD9; --s-sand:#E7DDCD; --s-ink:#0F0E0C; --s-ink-soft:#2A2824; --s-muted:#6B6560; --s-terra:#B84A2E; --s-terra-ink:#9E3F25; --s-amber:#C8944A;
  --f-display:Archivo,"Helvetica Neue",Arial,sans-serif; --f-serif:Fraunces,Georgia,serif; --f-body:Outfit,system-ui,sans-serif; --f-hand:Caveat,"Segoe Print",cursive; --f-mono:"JetBrains Mono",ui-monospace,monospace;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#14120F; --panel:#1E1B17; --panel-2:#27231D; --sand:#302B24;
  --ink:#F4EEE4; --ink-soft:#DDD5C8; --muted:#A39A8E; --line:rgba(244,238,228,.16);
  --accent:#D86A4A; --accent-ink:#EE9578; --amber:#D9A55A;
  --good:#7CC493; --good-bg:rgba(124,196,147,.14); --warn:#E2B461; --warn-bg:rgba(226,180,97,.16); --bad:#F08A80; --bad-bg:rgba(240,138,128,.14);
  --on-accent:#14120F; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#14120F; --panel:#1E1B17; --panel-2:#27231D; --sand:#302B24;
  --ink:#F4EEE4; --ink-soft:#DDD5C8; --muted:#A39A8E; --line:rgba(244,238,228,.16);
  --accent:#D86A4A; --accent-ink:#EE9578; --amber:#D9A55A;
  --good:#7CC493; --good-bg:rgba(124,196,147,.14); --warn:#E2B461; --warn-bg:rgba(226,180,97,.16); --bad:#F08A80; --bad-bg:rgba(240,138,128,.14);
  --on-accent:#14120F; color-scheme:dark}

*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font:400 15px/1.5 var(--f-body);padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:0 48px}
.wrap{max-width:1240px;margin:0 auto}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
h1,h2,h3{margin:0;text-wrap:balance}

/* top bar */
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:30}
.bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--bg);border-bottom:1px solid var(--line);margin:0 calc(-1*max(16px,env(safe-area-inset-left,0px)));padding:14px max(16px,env(safe-area-inset-right,0px)) 0 max(16px,env(safe-area-inset-left,0px))}
.bar-in{max-width:1240px;margin:0 auto;display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:8px 24px}
.brand{display:flex;flex-direction:column;gap:2px;padding-bottom:10px}
.brand b{font:800 26px/1 var(--f-display);letter-spacing:-.04em}
.brand b i{font:italic 400 26px/1 var(--f-serif);letter-spacing:-.02em;color:var(--accent-ink)}
.brand span{font:500 12px/1.2 var(--f-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.tabs{display:flex;gap:4px;flex-wrap:wrap}
.tab{background:none;border:0;border-bottom:3px solid transparent;padding:10px 14px;font-weight:600;color:var(--muted);cursor:pointer}
.tab[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--accent)}
.sync{font:500 12px/1 var(--f-mono);letter-spacing:.04em;color:var(--muted);padding-bottom:12px;display:flex;align-items:center;gap:8px}
.sync::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--amber)}
.sync.ok::before{background:var(--good)} .sync.off::before{background:var(--bad)}

main{padding-top:24px;display:flex;flex-direction:column;gap:24px}
.lede{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:12px 24px}
.lede h2{font:800 34px/1 var(--f-display);letter-spacing:-.04em}
.lede p{margin:6px 0 0;color:var(--muted);max-width:60ch}

.btn{background:var(--ink);color:var(--bg);border:0;border-radius:999px;padding:9px 18px;font-weight:600;cursor:pointer}
.btn.accent{background:var(--accent);color:var(--on-accent)}
.btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--line)}
.btn.sm{padding:5px 12px;font-size:13px}
.btn:disabled{opacity:.45;cursor:default}
.field{display:flex;flex-direction:column;gap:4px;min-width:0}
.field>label,.lab{font:500 11px/1.2 var(--f-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.in,.sel,.ta{width:100%;background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:9px 12px;min-width:0}
.ta{resize:vertical;min-height:84px;line-height:1.45}
.hint{font-size:12px;color:var(--muted)}

/* pipeline */
.board{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;align-items:start}
.col{background:var(--panel-2);border-radius:14px;padding:12px;display:flex;flex-direction:column;gap:10px;min-height:160px}
.col h3{font:500 12px/1 var(--f-mono);letter-spacing:.08em;text-transform:uppercase;display:flex;justify-content:space-between;color:var(--ink-soft)}
.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px;display:flex;flex-direction:column;gap:8px}
.card h4{margin:0;font:700 16px/1.25 var(--f-body)}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{font:500 11px/1 var(--f-mono);letter-spacing:.04em;padding:5px 8px;border-radius:999px;background:var(--sand);color:var(--ink-soft)}
.chip.dx::before{content:"";display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--amber);margin-right:6px}
.chip.good{background:var(--good-bg);color:var(--good)} .chip.warn{background:var(--warn-bg);color:var(--warn)} .chip.bad{background:var(--bad-bg);color:var(--bad)}
.card .row{display:flex;gap:6px;flex-wrap:wrap;align-items:center;justify-content:space-between}
.empty{border:1px dashed var(--line);border-radius:14px;padding:28px;color:var(--muted);text-align:center}
.addbox{display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:10px;align-items:end;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px}

/* studio */
.desk{display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,440px);gap:24px;align-items:start}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px;display:flex;flex-direction:column;gap:14px;min-width:0}
.meta{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
.meta .wide{grid-column:1/-1}
.slidebar{display:flex;gap:6px;flex-wrap:wrap}
.sb{position:relative;border:1px solid var(--line);background:var(--panel);border-radius:10px;padding:6px 22px 6px 10px;cursor:pointer;display:flex;flex-direction:column;align-items:flex-start;gap:2px;min-width:64px}
.sb b{font:800 15px/1 var(--f-display)}
.sb span{font:500 10px/1 var(--f-mono);letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.sb[aria-current="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.sb[aria-current="true"] span{color:inherit;opacity:.75}
.sb i{position:absolute;top:8px;right:8px;width:7px;height:7px;border-radius:50%;background:var(--good)}
.sb i.warn{background:var(--amber)} .sb i.bad{background:var(--bad)}
.preview{position:sticky;top:calc(env(safe-area-inset-top,0px) + 76px);display:flex;flex-direction:column;gap:12px}
.frame{width:100%;aspect-ratio:4/5;overflow:hidden;border-radius:8px;position:relative;box-shadow:0 0 0 1px var(--line);background:var(--s-paper)}
.frame.reel{aspect-ratio:9/16;max-width:300px;margin:0 auto}
.checks{display:flex;flex-direction:column;gap:6px}
.ck{display:flex;gap:8px;align-items:flex-start;font-size:13px;padding:6px 10px;border-radius:8px}
.ck.ok{background:var(--good-bg);color:var(--good)} .ck.warn{background:var(--warn-bg);color:var(--warn)} .ck.bad{background:var(--bad-bg);color:var(--bad)}
.ck::before{content:"";flex:none;width:8px;height:8px;margin-top:6px;border-radius:50%;background:currentColor}
.scores{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
.scores .field{justify-content:flex-end}
.scores .field input{text-align:center;font:800 20px/1 var(--f-display)}
.gate{font:700 14px/1.3 var(--f-body);padding:10px 14px;border-radius:10px}
.gate.ok{background:var(--good-bg);color:var(--good)} .gate.bad{background:var(--warn-bg);color:var(--warn)}
.two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.sheet{overflow-x:auto}
table{border-collapse:collapse;width:100%;min-width:760px}
th{font:500 11px/1.2 var(--f-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);text-align:left;padding:8px 8px;border-bottom:1px solid var(--line)}
td{padding:8px;border-bottom:1px solid var(--line);vertical-align:middle}
td input.n{width:54px;text-align:center;font-variant-numeric:tabular-nums}
.tot{font:800 20px/1 var(--f-display);font-variant-numeric:tabular-nums}
.promptbox{white-space:pre-wrap;font:500 13px/1.55 var(--f-mono);background:var(--panel-2);border-radius:12px;padding:16px;min-height:180px}
.sig{font:400 13px/1.5 var(--f-body);color:var(--muted)}
ul.plain{margin:0;padding-left:18px;display:flex;flex-direction:column;gap:6px}
.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(20px + env(safe-area-inset-bottom,0px));background:var(--ink);color:var(--bg);padding:10px 18px;border-radius:999px;font-weight:600;z-index:40}

/* carousel slide (1080x1350 canvas, scaled by --s) */
.sl{width:1080px;height:1350px;position:absolute;top:0;left:0;transform:scale(var(--s,.4));transform-origin:0 0;overflow:hidden;color:var(--s-ink);font-family:var(--f-body)}
.sl.reel{height:1920px}
.sl.soft{background:var(--hs,#F4EBD9)} .sl.hero{background:var(--hc,#B84A2E);color:#0F0E0C} .sl.paper{background:var(--s-paper)} .sl.cream{background:var(--s-cream)} .sl.sand{background:var(--s-sand)} .sl.ink{background:var(--s-ink-soft);color:#fff}
.sl .ph{position:absolute;inset:0;background:var(--hc,#B84A2E)}
.sl .ph::after{content:"";position:absolute;inset:0;opacity:.22;mix-blend-mode:overlay;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>")}
.sl .ph.has::after{display:none}
.sl.ink .hand{color:#fff}.sl.ink .h,.sl.ink .hi,.sl.ink .acc,.sl.ink .mega{text-shadow:0 2px 28px rgba(15,14,12,.32)}.sl.ink .num{color:#fff}
.sl .prog{position:absolute;left:72px;bottom:84px;display:flex;gap:8px;z-index:3}.sl .prog i{display:block;width:44px;height:8px;border-radius:8px}
.sl .bubble{position:absolute;display:inline-flex;align-items:center;gap:18px;background:#fff;color:#0F0E0C;border-radius:44px 44px 44px 10px;padding:30px 40px;box-shadow:0 14px 0 rgba(15,14,12,.9);font:700 50px/1.1 var(--f-body);max-width:860px}
.sl .bubble.me{background:#0F0E0C;color:#fff;border-radius:44px 44px 10px 44px;box-shadow:0 14px 0 var(--hc);font:600 38px/1.28 var(--f-body);max-width:800px;display:block}
.sl .sticker{position:absolute;background:#0F0E0C;color:#fff;border-radius:999px;padding:16px 28px;font:600 26px/1.2 var(--f-body);transform:rotate(-2deg);z-index:3;max-width:760px}
.sl .vrow{display:flex;gap:26px;align-items:flex-start;border-top:3px solid rgba(255,255,255,.22);padding-top:26px}.sl .vrow b{font:600 28px/1.6 var(--f-mono);color:var(--ha)}.sl .vrow span{font:700 42px/1.22 var(--f-body);color:#fff}
.sl .acard{flex:1;border-radius:44px;padding:0 44px;display:flex;align-items:center;gap:34px}.sl .acard .n{font:800 130px/1 var(--f-display);letter-spacing:-.05em;opacity:.9}.sl .acard .t{font:600 38px/1.28 var(--f-body)}.sl .acard .t b{display:block;font:800 58px/1 var(--f-display);letter-spacing:-.03em;margin-bottom:10px}
.sl .scard{flex:1;border-radius:44px;background:rgba(255,255,255,.09);border:2px solid rgba(255,255,255,.16);padding:0 44px;display:flex;align-items:center;gap:36px;color:#fff}.sl .scard .dot{flex:none;width:112px;height:112px;border-radius:50%;background:var(--ha);color:var(--hb);display:flex;align-items:center;justify-content:center;font:800 64px/1 var(--f-display)}.sl .scard .t{font:700 44px/1.25 var(--f-body)}
.sl .scrim{position:absolute;inset:0;background:linear-gradient(180deg,rgba(15,14,12,.05) 25%,rgba(15,14,12,.66) 100%)}
.sl .phn{position:absolute;left:72px;bottom:72px;font:500 22px/1.3 var(--f-mono);color:rgba(255,255,255,.8);letter-spacing:.06em;text-transform:uppercase;z-index:3;max-width:640px}
.sl .top{position:absolute;top:72px;left:72px;right:72px;display:flex;justify-content:space-between;align-items:flex-start;z-index:3}
.sl .case{display:inline-flex;align-items:center;gap:12px;font:500 21px/1 var(--f-mono);letter-spacing:.08em;text-transform:uppercase;border:2px solid;border-radius:999px;padding:12px 20px}
.sl .case::before{content:"";width:14px;height:14px;border-radius:50%;background:var(--s-amber)}
.sl .sig{text-align:right;font:600 22px/1.05 var(--f-body);color:inherit}
.sl .sig i{display:block;font:italic 400 26px/1.05 var(--f-serif)}
.sl .lock{position:absolute;left:72px;right:72px;text-align:center;color:#fff;z-index:2}
.sl .lead{font:500 46px/1.05 var(--f-body);margin-bottom:8px}
.sl .mega{font-family:var(--f-display);font-weight:800;line-height:.86;letter-spacing:-.055em;white-space:nowrap}
.sl .acc{font-family:var(--f-serif);font-style:italic;font-weight:400;line-height:.95;letter-spacing:-.02em;white-space:nowrap;margin-top:12px}
.sl .pill{display:inline-flex;align-items:center;padding:22px 42px;border-radius:999px;background:#0F0E0C;color:#fff;font:700 26px/1 var(--f-display);letter-spacing:.04em;text-transform:uppercase}
.sl .pill.small{padding:14px 26px;font-size:22px;background:var(--s-ink);color:var(--s-paper)}
.sl .num{position:absolute;left:72px;bottom:86px;font:500 24px/1 var(--f-mono);letter-spacing:.06em;color:var(--s-ink-soft)}
.sl .swipe{position:absolute;right:72px;bottom:72px}
.sl .h{font-family:var(--f-display);font-weight:800;line-height:.98;letter-spacing:-.045em}
.sl .hi{font-family:var(--f-serif);font-style:italic;font-weight:400;line-height:.98;letter-spacing:-.02em}
.sl .h,.sl .hi,.sl .st{text-wrap:balance}
.sl .cb{position:relative;align-self:flex-start;max-width:830px;background:#fff;color:#0F0E0C;border-radius:40px 40px 40px 10px;padding:28px 38px;box-shadow:0 12px 0 rgba(15,14,12,.9);font:600 38px/1.25 var(--f-body)}
.sl .cb.me{align-self:flex-end;background:#0F0E0C;color:#fff;border-radius:40px 40px 10px 40px;box-shadow:0 12px 0 var(--hc)}
.sl .cb i{position:absolute;top:-24px;left:-16px;width:50px;height:50px;border-radius:50%;background:var(--hc);color:var(--hon);font:800 24px/50px var(--f-display);text-align:center;font-style:normal}
.sl .cb.me i{left:auto;right:-16px}
.sl .arow{position:relative;display:flex;align-items:center;gap:26px;flex:1}
.sl .arow::before{content:'';position:absolute;left:45px;width:8px;background:#0F0E0C;top:0;bottom:-22px;border-radius:4px}
.sl .arow.first::before{top:50%}.sl .arow.last::before{bottom:50%}
.sl .anode{position:relative;flex:0 0 98px;width:98px;height:98px;border-radius:50%;display:flex;align-items:center;justify-content:center;font:800 40px/1 var(--f-display);box-shadow:0 0 0 8px #FBF8F3}
.sl .acard2{flex:1;background:#fff;border-radius:34px;padding:26px 34px;box-shadow:0 10px 0 rgba(15,14,12,.9)}
.sl .acard2 .t{font:600 36px/1.28 var(--f-body);color:#0F0E0C}
.sl .acard2 .t b{display:block;font:800 46px/1 var(--f-display);letter-spacing:-.03em;margin-bottom:8px;color:var(--hc)}
.sl .chk{flex:0 0 76px;width:76px;height:76px;border:6px solid var(--ha);border-radius:20px}
.sl .ibtn{display:flex;flex-direction:column;align-items:center;gap:14px}
.sl .ibtn span{width:120px;height:120px;border-radius:50%;background:#0F0E0C;display:flex;align-items:center;justify-content:center}
.sl .ibtn em{font:500 26px/1 var(--f-mono);letter-spacing:.06em;text-transform:uppercase;font-style:normal;color:var(--hon)}
.sl .body,.sl .bubble,.sl .bubble.me{text-wrap:pretty}
.sl .body{font:600 36px/1.32 var(--f-body)}
.sl .small{font:500 26px/1.35 var(--f-body);color:var(--s-muted)}
.sl .hand{font:600 54px/1 var(--f-hand);color:var(--s-terra-ink);white-space:nowrap}
.sl .stroke{fill:none;stroke:var(--s-terra);stroke-width:7;stroke-linecap:round;stroke-linejoin:round}
.sl .tile{position:absolute;border-radius:28px;overflow:hidden;box-shadow:0 18px 40px rgba(15,14,12,.18)}
.sl .row3{display:grid;grid-template-columns:96px 1fr;gap:24px;padding:34px 0;border-top:2px solid rgba(15,14,12,.18);align-items:start}
.sl .row3 .n{font:800 64px/1 var(--f-display);letter-spacing:-.04em;color:var(--s-ink-soft)}
.sl .row3 .t{font:600 38px/1.3 var(--f-body)}
.sl .row3 .t b{display:block;font:800 46px/1 var(--f-display);letter-spacing:-.03em;margin-bottom:8px}
.sl em{font-style:normal;color:var(--s-terra-ink)}

@media (max-width:1000px){.board{grid-template-columns:repeat(2,minmax(0,1fr))}.desk{grid-template-columns:minmax(0,1fr)}.preview{position:static}.meta{grid-template-columns:repeat(2,minmax(0,1fr))}.addbox{grid-template-columns:1fr 1fr}}
@media (max-width:560px){.board{grid-template-columns:minmax(0,1fr)}.two,.scores{grid-template-columns:minmax(0,1fr)}.scores{grid-template-columns:repeat(2,minmax(0,1fr))}.lede h2{font-size:28px}}
@media (prefers-reduced-motion:no-preference){.card,.btn{transition:transform .12s}.card:hover{transform:translateY(-1px)}}
.ptable{display:flex;flex-direction:column;gap:18px;margin-top:10px}
.pt-r{border:1px solid var(--line);border-radius:14px;padding:14px 16px;display:flex;flex-direction:column;gap:10px}
.pt-h{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.pt-h b{font:800 20px/1 var(--f-display,inherit)}.pt-h small{color:var(--muted);font-size:13px}
.pt-b{font-style:normal;font-size:12px;padding:3px 10px;border-radius:999px;background:var(--line);color:var(--ink)}.pt-b.ok{background:#B84A2E;color:#fff}.pt-b.warn{background:#C8944A;color:#0F0E0C}
.pt-c{display:flex;flex-direction:column;gap:6px}.pt-c label{font-size:12px;color:var(--muted)}.pt-c .btn{align-self:flex-start}
</style>

<div class="bar"><div class="bar-in">
  <div class="brand"><b>Content <i>Studio</i></b><span>The Brand Fixer · @aldysyahreza</span></div>
  <nav class="tabs" id="tabs" role="tablist" aria-label="Tampilan"></nav>
  <div class="sync" id="sync">Memuat data</div>
</div></div>
<div class="wrap"><main id="view"></main></div>
<div class="toast" id="toast" hidden></div>

<script>
(function(){
'use strict';
/* ---------- constants ---------- */
var DXN=['Brand Foundation','Brand Character','Brand Trust','Brand Experience','Internal Alignment','Marketing System','AI-Era Visibility'];
var JOBS=['Discovery','Save','Share','Trust','Lead','Speaker','Product'];
var STAGES=[['ide','Ide'],['copy','Copy'],['visual','Visual'],['siap','Siap posting'],['tayang','Tayang']];
var TYPES={cover:'Cover',scene:'Adegan',vertical:'Gejala',markup:'Diagnosis',akar:'Akar masalah',statement:'Reframe',action:'Langkah',cta:'CTA'};
var ORDER=['cover','scene','vertical','markup','akar','statement','action','cta'];
var FIELDS={
